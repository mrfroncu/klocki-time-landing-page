# ─────────────────────────────────────────────────────────────────────────────
#  Konfiguracja landing page serwera Klocki Time
#  Skopiuj ten plik do `.env` i uzupełnij wartości.
#  Zmienne są wczytywane podczas budowania (`npm run build`) — po ich zmianie
#  trzeba przebudować stronę. Alternatywa bez przebudowy: public/config.json.
# ─────────────────────────────────────────────────────────────────────────────

# — Serwer —
VITE_SERVER_NAME="Klocki Time"
# Adres kopiowany po kliknięciu — używany zarówno jako "wpisz to w kliencie
# Minecraft", jak i jako adres zapytania o status (ten sam string, dwa cele):
VITE_SERVER_ADDRESS="klocki-time.alleria.pl"
# Port — ZOSTAW PUSTE, jeśli domena ma rekord SRV (tak jest u nas: LazyMC na
# klocki-time.alleria.pl, SRV kieruje na network5.alleria.pl:60320). Puste
# = i gracz, i sprawdzanie statusu użyją samej domeny, a SRV/LazyMC same
# przekierują na właściwy port i obsłużą wybudzanie serwera ze snu.
# Ustaw tylko, gdy serwer NIE ma SRV i słucha na niestandardowym porcie.
# Uwaga: adres musi być publicznie osiągalny — prywatny/VPN-owy IP
# (np. z Tailscale, 100.x.x.x) nie zadziała, bo status pobiera zewnętrzne
# api.mcstatus.io, które nie ma dostępu do Twojej sieci prywatnej.
VITE_SERVER_PORT=""
# Krótki podtytuł w sekcji hero:
VITE_SERVER_TAGLINE="Prywatny serwer Minecraft dla znajomych."

# — Modpack (serwer nie udostępnia tych danych przez ping) —
VITE_MODPACK_NAME="Klocki Time Pack"
# Wersja modpacka — opcjonalnie (pusta = ukryta):
VITE_MODPACK_VERSION=""
# Wersja Minecraft pokazywana, gdy API statusu nie odpowie:
VITE_MC_VERSION_FALLBACK="1.20.1"

# — Linki (przyciski) —
# Discord: „Dołącz po paczkę modów"
VITE_DISCORD_URL="https://discord.gg/xxxxxxxx"

# "local"  = mapę serwuje BlueMap CLI z TEGO SAMEGO kontenera pod /map
#            (patrz sekcja "BlueMap" niżej) — dostępna cały czas, nawet gdy
#            serwer MC śpi, bo czyta gotowe kafelki z bazy SQL.
# "remote" = stary iframe do zewnętrznego VITE_MAP_URL, tylko gdy serwer online.
VITE_MAP_MODE="remote"
# Używane tylko gdy VITE_MAP_MODE="remote":
VITE_MAP_URL="https://kt-mapa.alleria.pl/"
# Strona statusu serwerów (nowa karta):
VITE_STATUS_URL="https://status.alleria.pl/"
# Panel zarządzania (nowa karta):
VITE_MANAGEMENT_URL="https://kt-management.alleria.pl/"

# — Zaawansowane (opcjonalne) —
# Bazowy adres API statusu Minecraft:
VITE_MCSTATUS_API_BASE="https://api.mcstatus.io/v2/status/java"
# Co ile sekund odświeżać status (min. 15):
VITE_STATUS_POLL_SECONDS="60"
# Czy w ogóle osadzać mapę (false = tylko karta z linkiem, niezależnie od trybu):
VITE_MAP_EMBED="true"

# ─────────────────────────────────────────────────────────────────────────────
#  BlueMap (tylko gdy VITE_MAP_MODE="local" i budujesz przez docker-compose)
#  Te zmienne NIE trafiają do obrazu (bez `docker build` przy zmianie) —
#  czytane są przy starcie kontenera. Baza to ta sama, do której renderuje
#  plugin BlueMap na serwerze MC (config/bluemap/storages/sql.conf tam).
# ─────────────────────────────────────────────────────────────────────────────
BLUEMAP_ENABLED="false"
# Endpoint bazy z panelu Pterodactyl (zakładka Databases):
BLUEMAP_DB_HOST=""
BLUEMAP_DB_PORT="3306"
BLUEMAP_DB_NAME=""
BLUEMAP_DB_USER=""
BLUEMAP_DB_PASSWORD=""
# Limit RAM dla procesu BlueMap CLI (sam webserver, bez renderowania — 256M starcza):
BLUEMAP_JAVA_MAX_MEM="256M"
